<section class="hero" aria-labelledby="hero-title">
  <img class="hero-illustration" src="<%- url_for('images/picnic-day.png') %>" alt="蓝天下，两只小狗依偎在开满粉色郁金香的草地上，身边放着野餐篮" width="1672" height="941" fetchpriority="high">
  <div class="hero-copy">
    <p class="hero-signature" lang="en"><%= theme.hero_signature %></p>
    <h1 id="hero-title" class="visually-hidden"><%= config.title %></h1>
    <div class="hero-clock" aria-label="当前时间">
      <time class="clock-time">--:--:--</time>
      <p class="clock-date">正在读取时间</p>
      <noscript>开启 JavaScript 即可显示当前时间。</noscript>
    </div>
    <p class="hero-description"><%= theme.hero_description %></p>
    <div class="hero-actions">
      <a class="button button-primary" href="#latest">开始阅读 <span aria-hidden="true">→</span></a>
      <a class="button button-quiet" href="<%- url_for('/archives/') %>">文章归档</a>
    </div>
    <p class="hero-note">把喜欢的瞬间，慢慢写成故事。</p>
  </div>
</section>

<section class="latest shell" id="latest" aria-labelledby="latest-title">
  <header class="section-heading">
    <p class="section-kicker" lang="en">LATEST ARTICLES</p>
    <h2 id="latest-title">最新文章</h2>
    <p>收藏日常里的小小闪光。</p>
  </header>
  <div class="post-list">
    <% page.posts.each(function(post) { %>
      <article class="post-preview">
        <a class="post-preview-art" href="<%- url_for(post.path) %>" tabindex="-1" aria-hidden="true">
          <img src="<%- url_for('images/picnic-day.png') %>" alt="" width="1672" height="941" loading="lazy">
        </a>
        <div class="post-preview-copy">
          <div class="post-meta"><time datetime="<%= date_xml(post.date) %>"><%= date(post.date, 'YYYY.MM.DD') %></time><% if (post.tags && post.tags.length) { %><span><%= post.tags.map(function(tag) { return tag.name; }).join(' · ') %></span><% } %></div>
          <h3><a href="<%- url_for(post.path) %>"><%= post.title || '未命名文章' %></a></h3>
          <p class="post-summary"><%= truncate(strip_html(post.excerpt || post.content), { length: 110, omission: '…' }) %></p>
          <a class="read-link" href="<%- url_for(post.path) %>">阅读全文 <span aria-hidden="true">→</span></a>
        </div>
      </article>
    <% }); %>
  </div>
  <% if (page.total > 1) { %><nav class="pagination" aria-label="文章分页"><%- paginator({ prev_text: '上一页', next_text: '下一页' }) %></nav><% } %>
  <a class="all-posts" href="<%- url_for('/archives/') %>">查看文章归档 <span aria-hidden="true">→</span></a>
</section>
